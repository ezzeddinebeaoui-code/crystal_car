# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string to MongoDB Atlas database.
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/crystal_rent_car?retryWrites=true&w=majority
# If not provided, the application runs on resilient embedded store and clearly indicates status.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/crystal_rent_car?retryWrites=true&w=majority"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens.
JWT_SECRET="crystal_rent_car_jwt_super_secret_key_2026"

# Initial Admin Bootstrap Configuration (Used only to seed the first protected administrator)
ADMIN_NAME="Crystal Administrator"
ADMIN_EMAIL="admin@crystalrentcar.com"
ADMIN_PASSWORD="AdminCrystal2026!Secure"
ADMIN_PHONE="+216 71 000 000"
